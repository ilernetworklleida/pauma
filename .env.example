# Maluap - variables de entorno
# Copia este archivo a .env y rellena las claves.
# NUNCA commitear .env real (esta en .gitignore).

# ════════════════════════════════════════════════════════════════
# TRANSCRIPCION
# ════════════════════════════════════════════════════════════════
# Proveedor: deepgram | assemblyai | none (solo Web Speech)
TRANSCRIBE_PROVIDER=deepgram

# Deepgram - https://console.deepgram.com
# Crea una "Member" API key normal en DEEPGRAM_API_KEY.
# Si ademas pones DEEPGRAM_PROJECT_ID con tu Project ID y DEEPGRAM_USE_TEMP_KEYS=1,
# el backend creara claves temporales (TTL 5 min) por sesion. Mas seguro.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
DEEPGRAM_USE_TEMP_KEYS=1

# AssemblyAI (alternativa no usada en v0.3)
ASSEMBLYAI_API_KEY=

# ════════════════════════════════════════════════════════════════
# TEXTO A VOZ (modo "yo hablo")
# ════════════════════════════════════════════════════════════════
# ElevenLabs - https://elevenlabs.io
# Voice IDs es-ES: 21m00Tcm4TlvDq8ikWAM (Rachel), pNInz6obpgDQGcFmaJgB (Adam)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# ════════════════════════════════════════════════════════════════
# BASE DE DATOS (MySQL en Hostinger)
# Usada por funcionalidades futuras (v0.4+): cuentas, sincronizacion,
# feedback de la comunidad, llamadas asistidas. En v0.3 NO es obligatoria.
# ════════════════════════════════════════════════════════════════
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ════════════════════════════════════════════════════════════════
# SMTP (email transaccional para magic link login + feedback)
# ════════════════════════════════════════════════════════════════
# Hostinger: smtp.hostinger.com puerto 465 (SSL/TLS implicito)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@maluap.es
SMTP_PASS=
SMTP_FROM=hola@maluap.es
SMTP_FROM_NAME=Maluap

# Destinatario del feedback que llega del formulario publico
FEEDBACK_TO=hola@maluap.es

# ════════════════════════════════════════════════════════════════
# SEGURIDAD
# ════════════════════════════════════════════════════════════════
# Origenes permitidos en CORS (separados por coma)
ALLOWED_ORIGIN=https://maluap.es

# Rate limit por IP a los endpoints /api/*
RATE_LIMIT_PER_MIN=20

# Secreto para firmar tokens internos (genera uno aleatorio largo)
APP_SECRET=cambia-esto-por-una-cadena-aleatoria-de-64-caracteres-minimo
