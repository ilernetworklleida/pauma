# Pauma - variables de entorno
# Copia este archivo a .env y rellena las claves.
# NUNCA commitear .env real (esta en .gitignore).

# Proveedor de transcripcion en vivo
# Opciones: deepgram | assemblyai | none (solo Web Speech API navegador)
TRANSCRIBE_PROVIDER=deepgram

# Deepgram - https://console.deepgram.com (Nova-2 con diarizacion en es-ES y ca)
DEEPGRAM_API_KEY=

# AssemblyAI - https://www.assemblyai.com (alternativa, mejor para batch / audios grabados)
ASSEMBLYAI_API_KEY=

# ElevenLabs - https://elevenlabs.io (voz natural para modo "yo hablo")
# Voice ID por defecto en espanol: 21m00Tcm4TlvDq8ikWAM (Rachel) o usa el tuyo
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Origen permitido (CORS) - dominio publico
ALLOWED_ORIGIN=https://maluap.es

# Rate limit (peticiones por minuto y IP a /api/token.php y /api/tts.php)
RATE_LIMIT_PER_MIN=20
